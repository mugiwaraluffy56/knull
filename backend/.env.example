# Backend configuration. All values have safe local defaults; override as needed.
KNULL_HTTP_ADDR=:8080
KNULL_DATABASE_URL=postgres://knull:knull@localhost:55432/knull?sslmode=disable
KNULL_REDIS_URL=redis://localhost:6379/0
KNULL_ALLOWED_ORIGIN=http://localhost:3000
KNULL_SHUTDOWN_TIMEOUT_SECONDS=10
KNULL_HEALTH_TIMEOUT_SECONDS=3

# Operator sign-in (OpenID Connect). Local defaults target the Keycloak realm
# started by docker-compose.
KNULL_OIDC_ISSUER=http://localhost:8081/realms/knull
KNULL_OIDC_CLIENT_ID=knull-backend
KNULL_OIDC_CLIENT_SECRET=knull-local-secret
KNULL_APP_BASE_URL=http://localhost:8080
KNULL_UI_BASE_URL=http://localhost:3000
KNULL_SESSION_TTL_SECONDS=28800
# Mark session cookies Secure. Keep false for local http; set true behind HTTPS.
KNULL_COOKIE_SECURE=false

# 32-byte AES-256 key (raw 32 chars, hex, or base64) for encrypting integration
# credentials at rest. Generate with: openssl rand -base64 32
# Without it, credential storage is disabled.
KNULL_SECRET_KEY=

# Alertmanager webhook shared secret (empty = intake disabled)
KNULL_ALERTMANAGER_SECRET=
KNULL_ALERT_SERVICE_LABEL=service
KNULL_ALERT_ENVIRONMENT_LABEL=environment

# TrueForge durable workflow runtime (empty = investigations disabled)
KNULL_TRUEFORGE_URL=
KNULL_TRUEFORGE_TOKEN=
# TrueForge authors validation code; a restricted EKS Job executes it.
KNULL_TRUEFORGE_INVESTIGATOR_MODEL=
KNULL_TRUEFORGE_VALIDATION_MODEL=
# Optional TrueForge-connected read-only MCP server. This name must refer to a
# connector registered in TrueForge; always provide an explicit tool allowlist.
KNULL_TRUEFORGE_INVESTIGATOR_MCP=
KNULL_TRUEFORGE_INVESTIGATOR_TOOLS=

# Read-only MCP servers (empty = that investigation disabled)
KNULL_K8S_MCP_URL=
KNULL_K8S_MCP_TOKEN=
KNULL_PROMETHEUS_MCP_URL=
KNULL_PROMETHEUS_MCP_TOKEN=
KNULL_GITHUB_MCP_URL=
KNULL_GITHUB_MCP_TOKEN=

# Jev decision-only MCP server. OpenAI Responses is the default endpoint.
# For OpenRouter, set KNULL_JEV_ENDPOINT=https://openrouter.ai/api/v1/responses
# and use an OpenRouter model ID such as openai/gpt-4o-mini. Set the provider
# key in this process environment; never put it in incident evidence or MCP calls.
KNULL_JEV_ADDR=127.0.0.1:8090
KNULL_JEV_API_KEY=
# Legacy alias accepted if KNULL_JEV_API_KEY is empty.
KNULL_JEV_OPENAI_API_KEY=
KNULL_JEV_ENDPOINT=
KNULL_JEV_MODEL=gpt-4o-mini
KNULL_JEV_TIMEOUT_SECONDS=30
KNULL_JEV_MAX_REQUESTS=1000
KNULL_JEV_MAX_OUTPUT_TOKENS=1000
KNULL_JEV_MAX_RETRIES=1

# API-to-Jev MCP connection; empty disables classification after collection.
KNULL_JEV_MCP_URL=
KNULL_JEV_MIN_CONFIDENCE=0.65

# Dedicated sandbox EKS cluster. All fields required to enable sandbox runs.
# Kubeconfig must contain only sandbox access; no production context or exec auth.
KNULL_SANDBOX_KUBECONFIG=
KNULL_SANDBOX_CONTEXT=
KNULL_SANDBOX_CLUSTER_UID=
KNULL_PRODUCTION_CLUSTER_UIDS=
KNULL_SANDBOX_IMAGE_REGISTRY=
KNULL_SANDBOX_CODE_IMAGE_DIGEST=
KNULL_SANDBOX_PULL_SECRET_NAME=

# Independent sandbox-local Prometheus checks, scoped by {{namespace}}.
KNULL_SANDBOX_PROMETHEUS_URL=
KNULL_SANDBOX_PROMETHEUS_TOKEN=
KNULL_SANDBOX_ERROR_RATE_QUERY=
KNULL_SANDBOX_P95_QUERY=

# Production executor is disabled unless explicitly enabled. Use only with the
# dedicated in-cluster service account in infra/production-executor/rbac.yaml.
# This config scopes one exact Deployment and pins the API server CA.
KNULL_PRODUCTION_EXECUTION_ENABLED=false
KNULL_PRODUCTION_CLUSTER=
KNULL_PRODUCTION_NAMESPACE=
KNULL_PRODUCTION_WORKLOAD=
KNULL_PRODUCTION_CA_SHA256=

# Live recovery verification reads production-scoped Prometheus ranges.
KNULL_PRODUCTION_PROMETHEUS_URL=
KNULL_PRODUCTION_PROMETHEUS_TOKEN=
KNULL_PRODUCTION_ERROR_RATE_QUERY=
KNULL_PRODUCTION_P95_QUERY=
