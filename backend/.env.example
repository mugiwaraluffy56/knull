# Backend configuration. All values have safe local defaults; override as needed.
KNULL_HTTP_ADDR=:8080
KNULL_DATABASE_URL=postgres://knull:knull@localhost:55432/knull?sslmode=disable
KNULL_REDIS_URL=redis://localhost:6379/0
KNULL_ALLOWED_ORIGIN=http://localhost:3000
KNULL_SHUTDOWN_TIMEOUT_SECONDS=10
KNULL_HEALTH_TIMEOUT_SECONDS=3

# Operator sign-in (OpenID Connect). Local defaults target the Keycloak realm
# started by docker-compose.
KNULL_OIDC_ISSUER=http://localhost:8081/realms/knull
KNULL_OIDC_CLIENT_ID=knull-backend
KNULL_OIDC_CLIENT_SECRET=knull-local-secret
KNULL_APP_BASE_URL=http://localhost:8080
KNULL_UI_BASE_URL=http://localhost:3000
KNULL_SESSION_TTL_SECONDS=28800
# Mark session cookies Secure. Keep false for local http; set true behind HTTPS.
KNULL_COOKIE_SECURE=false

# 32-byte AES-256 key (raw 32 chars, hex, or base64) for encrypting integration
# credentials at rest. Generate with: openssl rand -base64 32
# Without it, credential storage is disabled.
KNULL_SECRET_KEY=

# Alertmanager webhook shared secret (empty = intake disabled)
KNULL_ALERTMANAGER_SECRET=
KNULL_ALERT_SERVICE_LABEL=service
KNULL_ALERT_ENVIRONMENT_LABEL=environment

# TrueForge durable workflow runtime (empty = investigations disabled)
KNULL_TRUEFORGE_URL=
KNULL_TRUEFORGE_TOKEN=
